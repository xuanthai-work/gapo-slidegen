# Next.js uses this server-side proxy target; FastAPI uses the other SLIDEGEN_ variables.
SLIDEGEN_API_INTERNAL_URL=http://127.0.0.1:8000
SLIDEGEN_ENVIRONMENT=development
SLIDEGEN_DATABASE_URL=postgresql+psycopg://slidegen:slidegen@localhost:5432/slidegen
SLIDEGEN_STORAGE_ROOT=.data/storage
SLIDEGEN_MAX_UPLOAD_BYTES=26214400
SLIDEGEN_GENERATION_CONCURRENCY=2
SLIDEGEN_SESSION_TTL_HOURS=168
SLIDEGEN_SOURCE_RETENTION_HOURS=24
SLIDEGEN_RETENTION_CLEANUP_INTERVAL_SECONDS=300
SLIDEGEN_RETENTION_CLEANUP_BATCH_SIZE=100
# Redis Pub/Sub is optional; PostgreSQL-only operation remains the default.
# Keep false until load-testing concurrent jobs/SSE clients and ingress buffering.
# Dual-write still updates job.stream_data until streaming is the default.
SLIDEGEN_GENERATION_STREAMING_ENABLED=false
SLIDEGEN_REDIS_URL=
SLIDEGEN_GENERATION_EVENT_CHANNEL_PREFIX=slidegen:generation
# Use google-ai-studio temporarily to send source content to the Gemini Developer API.
SLIDEGEN_GENERATION_PROVIDER=stub
# Image generation is optional and uses a separate model from text generation.
SLIDEGEN_IMAGE_PROVIDER=disabled
SLIDEGEN_GOOGLE_API_KEY=
SLIDEGEN_GOOGLE_MODEL=
SLIDEGEN_GOOGLE_IMAGE_MODEL=
SLIDEGEN_GOOGLE_MAX_INPUT_CHARS=120000
SLIDEGEN_COMPANY_GATEWAY_URL=http://127.0.0.1:5000
SLIDEGEN_COMPANY_GATEWAY_API_KEY=
SLIDEGEN_COMPANY_GATEWAY_MODEL=cb/hnw-llm
SLIDEGEN_COMPANY_GATEWAY_CHAT_PATH=/v1/chat/completions

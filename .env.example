# Application
APP_ENV=development
SQL_ECHO=false
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000

# Neon Auth (Auth page -> Configuration details)
# Base URL is used by the Next.js SDK. JWKS is used only by FastAPI to verify JWTs.
NEON_AUTH_BASE_URL=https://your-neon-auth-url
NEON_AUTH_JWKS_URL=https://your-neon-auth-url/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
# Optional but recommended when shown in your Neon Auth token/configuration.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=

# Neon PostgreSQL
# The backend accepts a Neon URL copied as postgresql:// and normalizes it for asyncpg.
# Runtime should use the hostname containing -pooler when available.
DATABASE_URL=postgresql://user:password@pooled-host/database?sslmode=require&channel_binding=require

# Local file storage
FILE_STORAGE_BACKEND=filesystem
FILE_STORAGE_PATH=./storage
MAX_DOCUMENT_SIZE_MB=50
MAX_DOCUMENT_PAGES=50

# AI provider chain
AI_PRIMARY_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4.1
OPENAI_FALLBACK_2_MODEL=gpt-4.1-mini

# Runtime limits
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES_PER_PROVIDER=1
MAX_SLIDES_PER_PRESENTATION=10

# API embedding. Keep one model/dimension for an existing vector index;
# changing provider/model requires re-embedding all stored chunks.
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# AI vision OCR uses the configured Google -> OpenAI -> OpenAI model chain.
OCR_PROVIDER=ai
OCR_LANGUAGES=vie+eng
